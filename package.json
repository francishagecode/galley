{
  "name": "galley",
  "productName": "Galley",
  "private": true,
  "version": "0.1.0",
  "description": "Galley — a local Typst editor with live preview.",
  "author": "Francis Hage",
  "homepage": "https://github.com/francishagecode/galley",
  "repository": {
    "type": "git",
    "url": "https://github.com/francishagecode/galley.git"
  },
  "type": "module",
  "main": "electron/main.js",
  "desktopName": "galley.desktop",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build && npm run native",
    "native": "node scripts/build-native.js",
    "native:debug": "node scripts/build-native.js --debug",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@eslint/js": "9.39.4",
    "codemirror": "^6.0.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "vite": "^6.0.7"
  }
}
