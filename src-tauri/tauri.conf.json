{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galley",
  "version": "0.1.0",
  "identifier": "com.francishage.galley",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Galley",
        "width": 1280,
        "height": 820,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "A local Typst editor with live preview.",
    "longDescription": "Galley is a fast, local-first editor for the Typst typesetting language. It compiles your document in the background and shows a live, page-by-page preview with syntax highlighting, autocomplete, and instant feedback.",
    "homepage": "https://github.com/francishagecode/galley",
    "publisher": "Francis Hage",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "section": "text"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
